{
  "name": "product-analytics-agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"ng serve --host 127.0.0.1\"",
    "build": "ng build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.server.json --noEmit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "mssql": "^12.0.0",
    "node-sql-parser": "^5.4.0",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/mssql": "^9.1.8",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
