# Default: offline demo. No database or model credentials required.
DATA_MODE=demo
PORT=3000
# SQL Server uses SQL authentication. Create a restricted login using sql/02-permissions.sql.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ProductAnalyticsDemo
SQL_USER=analytics_reader
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=false
# Optional server-side access token. Required in sqlserver mode (minimum 24 characters).
APP_TOKEN=
# Optional OpenAI-compatible chat completions endpoint. Empty key = limited rule parser.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# To seed SQL Server, temporarily provide a separate writer credential.
SQL_SEED_USER=
SQL_SEED_PASSWORD=
# V2: query-policy.json is the server-owned allowlist; SQL_DATABASE must be authorized.
